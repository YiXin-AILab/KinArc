{
  "name": "kinarc-demo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "katex": "^0.18.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-stream-markdown": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "3.8.3",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}

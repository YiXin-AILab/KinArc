# 复制为同目录 .env 后填写。run.sh 使用 source 加载，请保留 export。

# 被测 Agent：OpenAI 兼容服务使用 openai/模型名。
export TEST_AGENT_LLM_MODEL='openai/your-model-name'
export TEST_AGENT_LLM_BASE_URL=''
export TEST_AGENT_LLM_API_KEY=''

# 用户模拟器和 NL 裁判共用以下配置，与被测 Agent 分别填写。
export TAU3_USER_LLM='openai/your-model-name'
export OPENAI_API_BASE=''
export OPENAI_API_KEY=''

# 项目专用 Redis；地址应与 local-config.json 指向的 Runtime YAML 一致。
export REDIS_HOST='127.0.0.1'
export REDIS_PORT='6379'
export REDIS_DATABASE='0'
export REDIS_USERNAME=''
export REDIS_PASSWORD=''

# Trace：启用时填写 OTLP HTTP traces 地址和认证头。
# 不使用 Trace 时，在 Runtime YAML 中设置 trace.enabled: false。
export OTEL_ENDPOINT='http://127.0.0.1:4318/v1/traces'
export OTEL_AUTHORIZATION=''

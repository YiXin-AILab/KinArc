# 复制为 .env 后必须替换所有占位凭证，再启动对外监听的服务。
POSTGRES_PASSWORD=replace-with-random-value
CLICKHOUSE_PASSWORD=replace-with-random-value
MINIO_ROOT_PASSWORD=replace-with-random-value
REDIS_AUTH=replace-with-random-value
SALT=replace-with-random-value
ENCRYPTION_KEY=replace-with-64-hex-characters
NEXTAUTH_SECRET=replace-with-random-value

LANGFUSE_INIT_ORG_ID=agentsystem-local
LANGFUSE_INIT_ORG_NAME=KinArc Local
LANGFUSE_INIT_PROJECT_ID=agentsystem
LANGFUSE_INIT_PROJECT_NAME=KinArc Runtime
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=replace-with-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=replace-with-secret-key
LANGFUSE_INIT_USER_EMAIL=admin@example.local
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=replace-with-random-value
# 通过节点 IP 访问时，将两个 PUBLIC_URL 中的 localhost 改为节点 IP。
LANGFUSE_WEB_BIND_HOST=0.0.0.0
LANGFUSE_WEB_HOST_PORT=3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_MEDIA_PUBLIC_URL=http://localhost:9091
LANGFUSE_MINIO_BIND_HOST=0.0.0.0
LANGFUSE_MINIO_HOST_PORT=9091

# KinArc Runtime
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# 启用 MySQL 存储时使用；默认 Redis 配置不会连接数据库。
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=agentsystem
# DATABASE_USERNAME=agentsystem
# DATABASE_PASSWORD=

# 使用本地或已有 S3/MinIO 时按需配置。
# TEST_ASSET_S3_ENDPOINT=http://127.0.0.1:9092
# TEST_ASSET_S3_BUCKET=agentsystem-assets
# TEST_ASSET_S3_REGION=us-east-1
# TEST_ASSET_S3_ACCESS_KEY=
# TEST_ASSET_S3_SECRET_KEY=

# Banking Agent 与真实模型测试共用配置；密钥只写入本地 .env。
TEST_AGENT_LLM_MODEL=openai/deepseek-v4-flash
TEST_AGENT_LLM_API_KEY=
TEST_AGENT_LLM_BASE_URL=https://api.deepseek.com

# EvoAgentBench 知识库与信息检索 Agent 共用 LLM 配置。
EAB_MODEL=openai/deepseek-v4-flash
EAB_API_KEY=
EAB_BASE_URL=https://api.deepseek.com

# 汽车售后客服 Agent（application/auto_after_sales）独立 LLM 配置；
# 同时作为该 Agent 知识库 relevance_gate 裁判模型。
AUTO_LLM_MODEL=openai/deepseek-v4-flash
AUTO_LLM_API_KEY=
AUTO_LLM_BASE_URL=https://api.deepseek.com

# 可选：汽车售后 Agent 知识库切换到 vector/hybrid 检索与 rerank 时使用。
# AUTO_KB_EMBEDDING_MODEL=jina_ai/jina-embeddings-v3
# AUTO_KB_RERANK_MODEL=jina_ai/jina-reranker-v2
# JINA_API_KEY=

# 可选 OTLP/Langfuse Trace；启用 Trace 配置后才需要。
# Authorization 包含完整认证 scheme。
OTEL_ENDPOINT=http://127.0.0.1:3000/api/public/otel/v1/traces
OTEL_AUTHORIZATION=

# 可选：Hydra UAT 真实 AssetStore 合约；仅在明确允许留下测试文件时配置。
TEST_HYDRA_TOKEN_URL=
TEST_HYDRA_UPLOAD_URL=
TEST_HYDRA_FILE_PREFIX=
TEST_HYDRA_BUSINESS_TYPE=
TEST_HYDRA_BUSINESS_ID=
TEST_HYDRA_TEMPLATE_CODE=
TEST_HYDRA_ITEM_CODE=
TEST_HYDRA_CREATOR_ID=

# 通用评测系统（evaluation/）Judge 裁判模型独立配置；密钥只写入本地 .env。
EVAL_JUDGE_LLM_MODEL=openai/deepseek-v4-flash
EVAL_JUDGE_LLM_API_KEY=
EVAL_JUDGE_LLM_BASE_URL=https://api.deepseek.com
